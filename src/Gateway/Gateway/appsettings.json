{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "lancamentos": {
        "ClusterId": "lancamentos",
        "Match": { "Path": "/lancamentos/{**resto}" }
      },
      "posicao": {
        "ClusterId": "posicao",
        "Match": { "Path": "/posicao/{**resto}" }
      }
    },
    "Clusters": {
      "lancamentos": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": {
          "principal": { "Address": "http://lancamentos-api:8080/" }
        }
      },
      "posicao": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": {
          "principal": { "Address": "http://posicao-api:8080/" }
        }
      }
    }
  }
}
