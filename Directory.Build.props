<Project>
  <!-- Regras de build comuns a todos os projetos (ver openspec/specs/qualidade-de-build). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Projetos de teste: nome terminado em .Tests (Unit, Integration ou Architecture). -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- O xUnit v3 exige executável; o Scenarios.Integration.Specs.Tests (SpecFlow.xUnit, xUnit v2 pelo VSTest) é biblioteca. -->
    <OutputType Condition="'$(MSBuildProjectName)' != 'Scenarios.Integration.Specs.Tests'">Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <!-- O projeto de cenários roda com SpecFlow.xUnit (xUnit v2) e declara os pacotes no próprio .csproj. -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) And '$(MSBuildProjectName)' != 'Scenarios.Integration.Specs.Tests'">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>
</Project>
